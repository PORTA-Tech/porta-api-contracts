{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://porta.dev/contracts/audit/audit-observability-metric.schema.json",
  "title": "AuditObservabilityMetric",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_name": { "const": "AuditObservabilityMetric" },
    "schema_version": { "const": "1.0.0" },
    "metric_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
    "metric_name": {
      "enum": [
        "audit_traces_written_total",
        "audit_traces_failed_total",
        "audit_access_denied_total",
        "audit_replay_mismatch_total",
        "audit_signature_verification_total"
      ]
    },
    "window_start": { "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp" },
    "window_end": { "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp" },
    "value": { "type": "number", "minimum": 0 },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 128 }
    }
  },
  "required": [
    "contract_name",
    "schema_version",
    "metric_id",
    "metric_name",
    "window_start",
    "window_end",
    "value",
    "labels"
  ]
}

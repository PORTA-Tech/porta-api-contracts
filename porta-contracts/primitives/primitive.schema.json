{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://porta.dev/contracts/primitives/primitive.schema.json",
  "title": "BehaviorPrimitive",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_name": { "const": "BehaviorPrimitive" },
    "schema_version": { "const": "1.0.0" },
    "primitive_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
    "machine_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
    "name": {
      "enum": [
        "motor_volatility_index",
        "interaction_burst_intensity",
        "focus_switch_rate",
        "sustained_attention_duration",
        "idle_fragmentation_index",
        "notification_reactivity_index"
      ]
    },
    "value": { "type": "number" },
    "unit": { "type": "string", "pattern": "^[a-zA-Z0-9_./%-]{1,24}$" },
    "baseline_mean": { "type": "number" },
    "baseline_std": { "type": "number", "minimum": 0 },
    "z_score": { "type": "number" },
    "ewma": { "type": "number" },
    "window_size": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "confidence": { "$ref": "../shared/common-defs.schema.json#/$defs/probability" },
    "computed_at": { "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp" }
  },
  "required": [
    "contract_name",
    "schema_version",
    "primitive_id",
    "machine_id",
    "name",
    "value",
    "unit",
    "baseline_mean",
    "baseline_std",
    "z_score",
    "ewma",
    "window_size",
    "confidence",
    "computed_at"
  ]
}
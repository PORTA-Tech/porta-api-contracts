{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://porta.dev/contracts/control/policy-decision-log.schema.json",
  "title": "ControlPlanePolicyDecisionLog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_name": { "const": "ControlPlanePolicyDecisionLog" },
    "schema_version": { "const": "1.0.0" },
    "decision_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
    "evaluated_at": { "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp" },
    "policy_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
    "policy_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_name": { "type": "string", "minLength": 3, "maxLength": 128 },
          "metric_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
          "aggregation": { "enum": ["avg", "p95", "p99", "max", "min"] },
          "window_seconds": { "type": "integer", "minimum": 15, "maximum": 3600 },
          "value": { "type": "number" }
        },
        "required": ["schema_name", "metric_name", "aggregation", "window_seconds", "value"]
      },
      "maxItems": 32
    },
    "condition_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operator": { "enum": [">", ">=", "<", "<=", "==", "!="] },
        "threshold": { "type": "number" },
        "actual_value": { "type": "number" },
        "matched": { "type": "boolean" }
      },
      "required": ["operator", "threshold", "actual_value", "matched"]
    },
    "decision_result": {
      "enum": [
        "triggered",
        "condition_not_met",
        "cooldown_active",
        "hourly_cap_reached",
        "global_cap_reached",
        "kill_switch_active",
        "safety_cap_reached"
      ]
    },
    "policy_order_index": { "type": "integer", "minimum": 0, "maximum": 1000000 }
  },
  "required": [
    "contract_name",
    "schema_version",
    "decision_id",
    "evaluated_at",
    "policy_id",
    "policy_hash",
    "input_metrics",
    "condition_evaluation",
    "decision_result",
    "policy_order_index"
  ]
}

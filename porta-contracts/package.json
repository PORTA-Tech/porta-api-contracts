{
  "name": "porta-contracts",
  "private": true,
  "version": "1.0.0",
  "description": "Canonical contract schemas and enforcement gates for PORTA",
  "type": "module",
  "scripts": {
    "contracts:validate": "node ./scripts/validate-schemas.mjs",
    "contracts:compat": "node ./scripts/check-compatibility.mjs",
    "contracts:drift": "node ./scripts/check-schema-drift.mjs",
    "contracts:generate": "node ./scripts/generate-ts-clients.mjs",
    "contracts:normalize": "node ./scripts/generate-normalized-schemas.mjs",
    "contracts:client-check": "node ./scripts/check-generated-clients.mjs",
    "contracts:typecheck": "tsc -p ./clients/ts/tsconfig.json --noEmit",
    "contracts:build": "node ./scripts/build-contracts.mjs",
    "contracts:policy-signature-test": "node ./scripts/validate-policy-signatures.mjs",
    "contracts:ingestion-validation-test": "node ./scripts/validate-control-plane-ingestion.mjs",
    "contracts:policy-execution-test": "node ./scripts/validate-control-plane-policy-execution.mjs",
    "contracts:audit-governance-test": "node ./scripts/validate-audit-governance.mjs",
    "contracts:tests": "node ./scripts/run-contract-tests.mjs && npm run contracts:policy-signature-test && npm run contracts:ingestion-validation-test && npm run contracts:policy-execution-test && npm run contracts:audit-governance-test",
    "contracts:check": "npm run contracts:validate && npm run contracts:compat && npm run contracts:drift && npm run contracts:client-check && npm run contracts:tests && npm run contracts:build"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^2.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "semver": "^7.6.3",
    "typescript": "^5.8.2"
  }
}

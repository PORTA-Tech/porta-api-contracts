{
  "$id": "https://porta.dev/contracts/control/ingestion-health-metric.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_name": {
      "const": "ControlPlaneIngestionHealthMetric"
    },
    "labels": {
      "additionalProperties": {
        "maxLength": 128,
        "type": "string"
      },
      "type": "object"
    },
    "metric_id": {
      "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
    },
    "metric_name": {
      "enum": [
        "validation_failures_total",
        "schema_mismatch_rate",
        "ingestion_latency_p95_ms",
        "producer_error_rate",
        "signature_verification_failures_total"
      ]
    },
    "producer_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
      "type": [
        "string",
        "null"
      ]
    },
    "schema_name": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "unit": {
      "enum": [
        "count",
        "ratio",
        "ms",
        "bytes"
      ]
    },
    "value": {
      "minimum": 0,
      "type": "number"
    },
    "window_end": {
      "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp"
    },
    "window_start": {
      "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp"
    }
  },
  "required": [
    "contract_name",
    "schema_version",
    "metric_id",
    "metric_name",
    "window_start",
    "window_end",
    "value",
    "unit",
    "labels"
  ],
  "title": "ControlPlaneIngestionHealthMetric",
  "type": "object"
}

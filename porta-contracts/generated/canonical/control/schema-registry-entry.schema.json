{
  "$id": "https://porta.dev/contracts/control/schema-registry-entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_patch": {
      "type": "boolean"
    },
    "allowed_producers": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "compatibility_mode": {
      "enum": [
        "exact_major_backward_minor_patch",
        "strict_exact",
        "full"
      ]
    },
    "contract_name": {
      "const": "ControlPlaneSchemaRegistryEntry"
    },
    "deprecation_state": {
      "enum": [
        "active",
        "deprecated",
        "blocked"
      ]
    },
    "max_clock_skew_seconds": {
      "maximum": 86400,
      "minimum": 0,
      "type": "integer"
    },
    "max_payload_bytes": {
      "maximum": 10485760,
      "minimum": 1024,
      "type": "integer"
    },
    "maximum_supported_minor": {
      "maximum": 9999,
      "minimum": 0,
      "type": "integer"
    },
    "minimum_supported_minor": {
      "maximum": 9999,
      "minimum": 0,
      "type": "integer"
    },
    "registered_schema_version": {
      "$ref": "../shared/common-defs.schema.json#/$defs/semver"
    },
    "required_mtls": {
      "type": "boolean"
    },
    "required_signature": {
      "type": "boolean"
    },
    "schema_name": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "updated_at": {
      "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp"
    }
  },
  "required": [
    "contract_name",
    "schema_version",
    "schema_name",
    "registered_schema_version",
    "compatibility_mode",
    "deprecation_state",
    "allowed_producers",
    "required_signature",
    "required_mtls",
    "minimum_supported_minor",
    "maximum_supported_minor",
    "allow_patch",
    "max_payload_bytes",
    "max_clock_skew_seconds",
    "updated_at"
  ],
  "title": "ControlPlaneSchemaRegistryEntry",
  "type": "object"
}

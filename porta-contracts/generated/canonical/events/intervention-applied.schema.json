{
  "$id": "https://porta.dev/contracts/events/intervention-applied.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_name": {
      "const": "InterventionAppliedEvent"
    },
    "event_id": {
      "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
    },
    "event_type": {
      "const": "intervention.applied"
    },
    "ingestion_timestamp": {
      "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp"
    },
    "machine_id": {
      "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "applied_at": {
          "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp"
        },
        "duration_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "intervention_id": {
          "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
        },
        "outcome": {
          "enum": [
            "success",
            "noop",
            "deferred"
          ]
        },
        "policy_id": {
          "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
        },
        "state_id": {
          "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
        }
      },
      "required": [
        "intervention_id",
        "policy_id",
        "state_id",
        "applied_at",
        "duration_ms",
        "outcome"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "timestamp": {
      "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp"
    }
  },
  "required": [
    "contract_name",
    "schema_version",
    "event_id",
    "machine_id",
    "event_type",
    "timestamp",
    "ingestion_timestamp",
    "payload"
  ],
  "title": "InterventionAppliedEvent",
  "type": "object"
}

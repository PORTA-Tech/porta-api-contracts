{
  "$id": "https://porta.dev/contracts/events/intervention-failed.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_name": {
      "const": "InterventionFailedEvent"
    },
    "event_id": {
      "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
    },
    "event_type": {
      "const": "intervention.failed"
    },
    "ingestion_timestamp": {
      "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp"
    },
    "machine_id": {
      "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "error_class": {
          "enum": [
            "validation",
            "execution",
            "authorization",
            "dependency"
          ]
        },
        "error_code": {
          "pattern": "^[A-Z0-9_]{3,64}$",
          "type": "string"
        },
        "failed_at": {
          "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp"
        },
        "intervention_id": {
          "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
        },
        "policy_id": {
          "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
        }
      },
      "required": [
        "intervention_id",
        "policy_id",
        "error_code",
        "error_class",
        "failed_at"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "timestamp": {
      "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp"
    }
  },
  "required": [
    "contract_name",
    "schema_version",
    "event_id",
    "machine_id",
    "event_type",
    "timestamp",
    "ingestion_timestamp",
    "payload"
  ],
  "title": "InterventionFailedEvent",
  "type": "object"
}

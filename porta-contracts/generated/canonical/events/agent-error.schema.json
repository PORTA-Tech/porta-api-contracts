{
  "$id": "https://porta.dev/contracts/events/agent-error.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_name": {
      "const": "AgentErrorEvent"
    },
    "event_id": {
      "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
    },
    "event_type": {
      "const": "agent.error"
    },
    "ingestion_timestamp": {
      "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp"
    },
    "machine_id": {
      "$ref": "../shared/common-defs.schema.json#/$defs/uuid"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "error_code": {
          "pattern": "^[A-Z0-9_]{3,64}$",
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      },
      "required": [
        "error_code",
        "severity",
        "retryable"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "timestamp": {
      "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp"
    }
  },
  "required": [
    "contract_name",
    "schema_version",
    "event_id",
    "machine_id",
    "event_type",
    "timestamp",
    "ingestion_timestamp",
    "payload"
  ],
  "title": "AgentErrorEvent",
  "type": "object"
}

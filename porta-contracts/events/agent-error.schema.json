{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://porta.dev/contracts/events/agent-error.schema.json",
  "title": "AgentErrorEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_name": { "const": "AgentErrorEvent" },
    "schema_version": { "const": "1.0.0" },
    "event_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
    "machine_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
    "event_type": { "const": "agent.error" },
    "timestamp": { "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp" },
    "ingestion_timestamp": { "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error_code": { "type": "string", "pattern": "^[A-Z0-9_]{3,64}$" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "retryable": { "type": "boolean" }
      },
      "required": ["error_code", "severity", "retryable"]
    }
  },
  "required": ["contract_name", "schema_version", "event_id", "machine_id", "event_type", "timestamp", "ingestion_timestamp", "payload"]
}
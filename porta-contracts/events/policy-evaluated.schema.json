{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://porta.dev/contracts/events/policy-evaluated.schema.json",
  "title": "PolicyEvaluatedEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_name": { "const": "PolicyEvaluatedEvent" },
    "schema_version": { "const": "1.0.0" },
    "event_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
    "machine_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
    "event_type": { "const": "policy.evaluated" },
    "timestamp": { "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp" },
    "ingestion_timestamp": { "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
        "policy_version": { "$ref": "../shared/common-defs.schema.json#/$defs/semver" },
        "state_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
        "match": { "type": "boolean" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]{3,64}$" },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": ["policy_id", "policy_version", "state_id", "match", "reason_codes"]
    }
  },
  "required": ["contract_name", "schema_version", "event_id", "machine_id", "event_type", "timestamp", "ingestion_timestamp", "payload"]
}
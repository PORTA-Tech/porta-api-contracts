{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://porta.dev/contracts/events/intervention-applied.schema.json",
  "title": "InterventionAppliedEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_name": { "const": "InterventionAppliedEvent" },
    "schema_version": { "const": "1.0.0" },
    "event_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
    "machine_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
    "event_type": { "const": "intervention.applied" },
    "timestamp": { "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp" },
    "ingestion_timestamp": { "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intervention_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
        "policy_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
        "state_id": { "$ref": "../shared/common-defs.schema.json#/$defs/uuid" },
        "applied_at": { "$ref": "../shared/common-defs.schema.json#/$defs/isoTimestamp" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "outcome": { "enum": ["success", "noop", "deferred"] }
      },
      "required": ["intervention_id", "policy_id", "state_id", "applied_at", "duration_ms", "outcome"]
    }
  },
  "required": ["contract_name", "schema_version", "event_id", "machine_id", "event_type", "timestamp", "ingestion_timestamp", "payload"]
}